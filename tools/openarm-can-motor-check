#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ "${OPENARM_USE_UPSTREAM_MOTOR_CHECK:-0}" == "1" ]]; then
  exec "${ROOT_DIR}/external/openarm_can_1.2.2/build/openarm-can-motor-check" "$@"
fi

exec "${ROOT_DIR}/.venv/bin/python" "${ROOT_DIR}/tools/openarm_can_motor_check_safe.py" "$@"
