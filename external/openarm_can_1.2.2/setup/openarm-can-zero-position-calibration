# ---------- Main ----------


def main():
    global WORKSTATION_MAX_BUMP_DEG, WORKSTATION_MAX_BUMP_TIME_S
    global WORKSTATION_BUMP_BASE_STEP_DEG, WORKSTATION_BUMP_DT_S
    parser = argparse.ArgumentParser(
        description='Zero-pos calibration (compact)')
    parser.add_argument('--canport', type=str, default='can0')
    parser.add_argument('--arm-side', '--arm_side', dest='arm_side', type=str,
                        default='right_arm', choices=['right_arm', 'left_arm'])
    parser.add_argument('--fd', action='store_true',
                        help='Enable CAN-FD frames. Default is classic CAN 2.0 for the workstation.')
    parser.add_argument('--verify-only', action='store_true',
                        help='Verify feedback sync and low-gain hold, then disable before any limit-search motion.')
    parser.add_argument('--skip-gripper-limit-search', action='store_true',
                        help='Do not move the gripper during zero limit search. Factory workflow validates gripper motion in Demo instead.')
    parser.add_argument('--restore-initial-pose', action='store_true',
                        help='After zero is written, slowly return to the physical pose captured before calibration.')
    parser.add_argument('--restore-max-deg', type=float, default=WORKSTATION_RESTORE_MAX_DEG,
                        help='Maximum per-joint restore motion allowed after zero is written.')
    parser.add_argument('--max-bump-deg', type=float, default=WORKSTATION_MAX_BUMP_DEG,
                        help='Maximum motion allowed while searching one mechanical limit.')
    parser.add_argument('--max-bump-time-s', type=float, default=WORKSTATION_MAX_BUMP_TIME_S,
                        help='Maximum time allowed while searching one mechanical limit.')
    parser.add_argument('--bump-step-deg', type=float, default=WORKSTATION_BUMP_BASE_STEP_DEG,
                        help='Base step size for limit search before step scale is applied.')
    parser.add_argument('--bump-dt-s', type=float, default=WORKSTATION_BUMP_DT_S,
                        help='Delay between limit-search steps.')
    args = parser.parse_args()
    WORKSTATION_MAX_BUMP_DEG = max(1.0, float(args.max_bump_deg))
    WORKSTATION_MAX_BUMP_TIME_S = max(1.0, float(args.max_bump_time_s))
    WORKSTATION_BUMP_BASE_STEP_DEG = max(0.01, float(args.bump_step_deg))
    WORKSTATION_BUMP_DT_S = max(0.001, float(args.bump_dt_s))
    print(f"parser arg : {args}")
    effective_bump_speed = WORKSTATION_BUMP_BASE_STEP_DEG * WORKSTATION_BUMP_STEP_SCALE / WORKSTATION_BUMP_DT_S
    print(f"[WORKSTATION_SAFE] gain_scale={WORKSTATION_GAIN_SCALE} max_bump_deg={WORKSTATION_MAX_BUMP_DEG} "
          f"max_bump_time_s={WORKSTATION_MAX_BUMP_TIME_S} bump_speed_deg_s={effective_bump_speed:.2f}")

    # Init
    openarm = oa.OpenArm(args.canport, args.fd)
    send_can_ids, recv_can_ids, gripper_send_can_id, gripper_recv_can_id = _ids_for_side(args.arm_side)

    openarm.init_arm_motors(
        [oa.MotorType.DM8009, oa.MotorType.DM8009, oa.MotorType.DM4340, oa.MotorType.DM4340,
         oa.MotorType.DM4310, oa.MotorType.DM4310, oa.MotorType.DM4310],
        send_can_ids,
        recv_can_ids
    )
    openarm.init_gripper_motor(oa.MotorType.DM4310, gripper_send_can_id, gripper_recv_can_id)
    openarm.set_callback_mode_all(oa.CallbackMode.STATE)

    arm = openarm.get_arm()
    grip = openarm.get_gripper()
    am = arm.get_motors()
    gm = grip.get_motors()
    initial_arm_q, initial_grip_q = _read_initial_positions_workbench(args.canport, args.arm_side)
    print("[INFO] initial arm q:", [round(q, 6) for q in initial_arm_q], flush=True)
    print("[INFO] initial gripper q:", [round(q, 6) for q in initial_grip_q], flush=True)

    print("Enabling...")
    _safe_enable_hold(openarm, arm, grip, initial_arm_q, initial_grip_q)
    print("Enabled...")
    _verify_openarm_position_sync(openarm, arm, grip, initial_arm_q, initial_grip_q)

    for idx, motor in enumerate(am, start=1):
        print(f"[ENABLE_CHECK] J{idx}: enabled={motor.is_enabled()} pos={motor.get_position():.6f}", flush=True)
    print(f"[ENABLE_CHECK] GRIPPER: enabled={gm[0].is_enabled()} pos={gm[0].get_position():.6f}", flush=True)
    print("[INFO] openarm_can Motor.is_enabled() is not updated by state feedback; raw status is verified by workstation checks.", flush=True)

    try:
        if args.verify_only:
            print("[VERIFY_ONLY] Feedback sync verified; disabling before limit-search motion.", flush=True)
            _safe_disable_all(openarm)
            print("RESULT: VERIFY_ONLY_PASS", flush=True)
            return

        # Run side-specific calibration sequence
        ideal, deltas = (_run_right_sequence if args.arm_side == 'right_arm'
                         else _run_left_sequence)(
            openarm,
            arm,
            grip,
            include_gripper=not args.skip_gripper_limit_search,
        )

        # Compute ideal deltas per joint
        joint_order = [JointID.J1, JointID.J2, JointID.J3, JointID.J4,
                       JointID.J5, JointID.J6, JointID.J7, JointID.GRIPPER]
        ideal_delta_map = {}
        for j, d in zip(joint_order, deltas):
            if j == JointID.GRIPPER:
                print("ideal[GRIPPER] skipped")
                continue
            val = calc_delta_to_zero_pos_joint(
                initial_rad=initial_arm_q[int(j)],
                ideal_limit_rad=ideal[j],
                delta_to_stop_rad=d,
                joint_id=j
            )
            ideal_delta_map[j] = val
            # print(f"ideal[{j.name}] : {val:.6f} rad")

        # Absolute goal = initial + ideal_delta
        arm_goal_abs = [initial_arm_q[i] +
                        ideal_delta_map.get(JointID(i), 0.0) for i in range(7)]
        # TODO: move_to_precise_home(openarm, arm_goal_abs)
        pre_zero_arm_q = [motor.get_position() for motor in arm.get_motors()]
        pre_zero_grip_q = [motor.get_position() for motor in grip.get_motors()]
        print("[INFO] pre-zero arm q:", [round(q, 6) for q in pre_zero_arm_q], flush=True)
        print("[INFO] pre-zero gripper q:", [round(q, 6) for q in pre_zero_grip_q], flush=True)
        if args.restore_initial_pose:
            restore_target_q = _restore_target_for_initial_pose(initial_arm_q, pre_zero_arm_q)
            restore_target_grip_q = _restore_gripper_target_for_initial_pose(initial_grip_q, pre_zero_grip_q)
            print("[RESTORE] target q in new zero frame:", [round(q, 6) for q in restore_target_q], flush=True)
            print("[RESTORE] target gripper q in new zero frame:", [round(q, 6) for q in restore_target_grip_q], flush=True)
            _assert_restore_target_allowed(restore_target_q, args.restore_max_deg, restore_target_grip_q)

        # Zero must be written while the arm is still at the calibrated pose.
        # Keep the disable window short to avoid backdrive/drift before set_zero_all.
        _quick_disable_and_write_zero(openarm, arm, grip, canport=args.canport, arm_side=args.arm_side)
        print("wrote zero positon to arm")
        if args.restore_initial_pose:
            restore_initial_pose_after_zero(
                openarm,
                arm,
                grip,
                initial_arm_q=initial_arm_q,
                initial_grip_q=initial_grip_q,
                pre_zero_arm_q=pre_zero_arm_q,
                pre_zero_grip_q=pre_zero_grip_q,
                max_deg=args.restore_max_deg,
            )
            print("[RESTORE] initial physical pose restored", flush=True)

    except KeyboardInterrupt:
        print("\n[INFO] Ctrl+C pressed → stopping safely")
    finally:
        _safe_disable_all(openarm)
        print("[INFO] Motors disabled, exiting safely.")


if __name__ == "__main__":
    main()
